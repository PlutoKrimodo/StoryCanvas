# ============================================================
# StoryCanvas 公共环境变量模板
#
# 用法：cp .env.example .env 后填写真实值
#
# 安全约定：
#   - .env 已被 .gitignore 忽略，禁止提交
#   - 生产环境请用 openssl rand 生成随机密钥，不要复用示例值
#   - 本文件是公共配置来源；AI 服务商密钥见下方同名段（docker-compose 注入）
#     与 ai-service/.env.example（本地直跑 AI 服务时）
# ============================================================

# ==================== 数据库 ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=storycanvas
DB_USER=storycanvas
# 必填，无默认值（docker-compose 中缺失会直接启动失败）
DB_PASSWORD=change_me

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== JWT（必填）====================
# 生成方式：openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=604800
# 游客会话 Token 寿命（秒）；游客无需登录即可体验生成
JWT_GUEST_TOKEN_EXPIRY=604800

# ==================== Guest-first（T-1 能力层）====================
# 游客可免费生成的图片数；用尽后返回 429，提示登录后继续
GUEST_GENERATION_QUOTA=1
# 全站每日生成上限（对游客与登录用户同时生效），按 Asia/Shanghai 自然日重置。
# 游客身份可无限重取，仅靠上面的个人额度封不住共用系统 Key 的花费。
# 注意重试按任务进行：1 个任务最坏产生 TASK_RETRY_COUNT 次计费调用。
GLOBAL_DAILY_GENERATION_CAP=20

# ==================== 接口限流（Q5 / Q3①）====================
# 内存固定窗口限流（窗口 60s，进程重启后计数清零）。
# 固定窗口在窗口边界处允许瞬时两倍流量，属 MVP 可接受取舍（后续可迁 Redis）。
# 规格：docs/16 §7.4；实现：backend/filters/RateLimitFilter.cpp
# <=0 表示该档位不限制；总开关仅供开发 / 压测环境关闭。
RATE_LIMIT_ENABLED=true
# 匿名（无有效 Token，按客户端 IP）
RATE_LIMIT_ANON_PER_MIN=100
# 认证（有效 Token：正式用户与游客，按用户）
RATE_LIMIT_AUTH_PER_MIN=1000
# AI 生成（任务创建 / 重新生成，按身份）：1 个任务最坏 TASK_RETRY_COUNT 次计费调用
RATE_LIMIT_GENERATION_PER_MIN=10
# 游客会话签发（POST /auth/guest，按 IP），防止无限换取游客身份
RATE_LIMIT_GUEST_TOKEN_PER_MIN=10

# ==================== 后端 ↔ AI 服务（必填）====================
AI_SERVICE_URL=http://localhost:8000
# 内网调用鉴权密钥，后端与 AI 服务需保持一致
AI_SERVICE_API_KEY=change_me_internal_key
# 后端调用 AI 服务的超时（秒）；图像生成为长耗时操作，默认 180
AI_SERVICE_TIMEOUT=180

# ==================== AI 服务商（docker-compose 注入 ai-service）====================
# 演示默认走真实厂商；开发/测试/故障兜底可切 mock
LLM_PROVIDER=deepseek
IMAGE_PROVIDER=doubao
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ARK_API_KEY=
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-flash-260915
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com
WANX_IMAGE_MODEL=wan2.6-image
# 单个生成任务内部的最大重试次数；每次重试都是一次真实计费调用，演示环境建议保持 2
TASK_RETRY_COUNT=2

# ==================== 敏感字段加密（可选）====================
# 用于对确需落库的敏感字段做 AES-256-GCM 加密
# 生成方式：openssl rand -base64 32
ENCRYPTION_KEY=

# ==================== CORS 与日志 ====================
# 多个来源用英文逗号分隔
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ==================== 服务端口 ====================
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173

# ==================== 开发环境 ====================
DEBUG=false

# ==================== 文件存储 ====================
# 该路径相对各服务的工作目录解析：
#   - 后端从 backend/ 启动、AI 服务从 ai-service/ 启动，故统一用 ../storage 指向仓库根 storage/
#   - 两者必须指向同一目录，否则后端读不到 AI 服务落盘的生成图
#   - docker-compose 会以 STORAGE_PATH=/app/storage 覆盖
STORAGE_PATH=../storage
