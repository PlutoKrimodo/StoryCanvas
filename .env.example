# ============================================================
# StoryCanvas 公共环境变量模板
#
# 用法：cp .env.example .env 后填写真实值
#
# 安全约定：
#   - .env 已被 .gitignore 忽略，禁止提交
#   - 生产环境请用 openssl rand 生成随机密钥，不要复用示例值
#   - 本文件是公共配置的唯一来源；AI 服务商密钥见 ai-service/.env.example
# ============================================================

# ==================== 数据库 ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=storycanvas
DB_USER=storycanvas
# 必填，无默认值（docker-compose 中缺失会直接启动失败）
DB_PASSWORD=change_me

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== JWT（必填）====================
# 生成方式：openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=604800

# ==================== 后端 ↔ AI 服务（必填）====================
AI_SERVICE_URL=http://localhost:8000
# 内网调用鉴权密钥，后端与 AI 服务需保持一致
AI_SERVICE_API_KEY=change_me_internal_key

# ==================== 敏感字段加密（可选）====================
# 用于对确需落库的敏感字段做 AES-256-GCM 加密
# 生成方式：openssl rand -base64 32
ENCRYPTION_KEY=

# ==================== CORS 与日志 ====================
# 多个来源用英文逗号分隔
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ==================== 服务端口 ====================
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173

# ==================== 开发环境 ====================
DEBUG=false

# ==================== 文件存储 ====================
STORAGE_PATH=./storage
