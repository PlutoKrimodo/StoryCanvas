{
  "app": {
    "name": "StoryCanvas Backend",
    "threads": 4,
    "log_level": "info"
  },
  "listeners": [
    {
      "address": "0.0.0.0",
      "port": 8080
    }
  ],

  "//": "以下段落仅保留非敏感默认值；password / secret / api_key 一律留空，由环境变量注入（见 .env.example）",

  "database": {
    "type": "postgresql",
    "host": "localhost",
    "port": 5432,
    "database": "storycanvas",
    "username": "storycanvas",
    "password": "",
    "min_connections": 5,
    "max_connections": 20
  },
  "redis": {
    "host": "localhost",
    "port": 6379,
    "password": "",
    "database": 0
  },
  "jwt": {
    "secret": "",
    "access_token_expiry": 3600,
    "refresh_token_expiry": 604800
  },
  "ai_service": {
    "url": "http://localhost:8000",
    "api_key": "",
    "timeout": 60
  },
  "cors": {
    "allowed_origins": "http://localhost:5173"
  },
  "security": {
    "encryption_key": ""
  },
  "storage": {
    "type": "local",
    "local_path": "./storage"
  },
  "log": {
    "loggers": [
      {
        "name": "basic",
        "type": "console",
        "level": "info"
      }
    ]
  }
}
