# ============================================================
# AI Service 专属环境变量
#
# 注意：数据库 / JWT / 端口等公共配置统一放在仓库根目录的 .env.example，
#       此处只保留 AI Service 自身需要的变量，避免两处重复与冲突。
# ============================================================

# ==================== AI Provider 开关 ====================
# 演示默认走真实厂商；开发/测试/故障兜底可切 mock
LLM_PROVIDER=deepseek        # deepseek | mock
IMAGE_PROVIDER=doubao        # doubao | wanx | mock

# ==================== LLM：DeepSeek ====================
DEEPSEEK_API_KEY=sk-your_deepseek_key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ==================== 图像：豆包·Seedream（火山方舟，主用）====================
ARK_API_KEY=your_ark_api_key
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-4-0-xxxx

# ==================== 图像：通义万相（阿里云百炼，备用）====================
DASHSCOPE_API_KEY=sk-your_dashscope_key
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com
WANX_IMAGE_MODEL=wan2.6-image

# ==================== 内部鉴权 ====================
# 与后端 AI_SERVICE_API_KEY 保持一致；后端调用本服务时用于校验
INTERNAL_API_KEY=your_internal_api_key

# ==================== 服务配置 ====================
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ==================== CORS ====================
# 支持 JSON 数组或逗号分隔两种写法
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ==================== 存储与超时 ====================
# 必须与后端 STORAGE_PATH 指向同一目录（开发时均为仓库根 storage/），
# 否则后端读不到本服务落盘的生成图
STORAGE_PATH=../storage
LLM_TIMEOUT=30
IMAGE_TIMEOUT=120

# ==================== Mock 兜底 ====================
# Mock 图像 Provider 的模拟耗时（秒），便于观察前端轮询；置 0 可加速测试
MOCK_IMAGE_DELAY=1.5
